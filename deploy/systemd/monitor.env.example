# Copy to /etc/relay/monitor.env with mode 0600 and ownership root:root.
# Use the production Postgres connection string. Do not commit the real value.
DATABASE_URL=postgresql://relay-monitor:replace-me@example.invalid/relay?sslmode=verify-full

RELAY_STALE_PROCESSING_MINUTES=15
RELAY_READY_PENDING_ALERT_MINUTES=30

# This monitor is read-only. Keep the live-send guard explicitly disabled.
RELAY_ENABLE_LIVE_OUTREACH_SEND=false
